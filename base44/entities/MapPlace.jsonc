{
  "name": "MapPlace",
  "type": "object",
  "title": "MapPlace",
  "description": "An admin-created place shown on the interactive map. Positioned via drag-and-drop and keyed by slug.",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Unique URL-safe identifier for this place"
    },
    "label": {
      "type": "string",
      "description": "Display name on the map"
    },
    "short_desc": {
      "type": "string",
      "description": "Short description shown in the hover popover"
    },
    "kind": {
      "type": "string",
      "enum": [
        "culture",
        "nature",
        "beach",
        "city"
      ],
      "default": "culture",
      "description": "Category \u2014 controls the badge icon and color"
    },
    "google_maps_url": {
      "type": "string",
      "description": "Optional Google Maps link"
    },
    "photo_url": {
      "type": "string",
      "format": "uri",
      "description": "Optional photo shown in the popover"
    },
    "x": {
      "type": "number",
      "default": 50,
      "description": "Horizontal position as percent (0-100)"
    },
    "y": {
      "type": "number",
      "default": 50,
      "description": "Vertical position as percent (0-100)"
    },
    "zone": {
      "type": "string",
      "enum": [
        "north",
        "city",
        "south"
      ],
      "description": "Zone group for the Grouped Areas tab"
    },
    "day": {
      "type": "integer",
      "description": "Day number (1-3) for the 3-Day Itinerary tab; leave empty to exclude"
    },
    "day_order": {
      "type": "integer",
      "description": "Order of the stop within its itinerary day (for the route line)"
    },
    "distance_km": {
      "type": "number",
      "description": "Distance in km from Kraton (0 KM anchor)"
    },
    "duration_min": {
      "type": "number",
      "description": "Approx. travel time in minutes from Kraton"
    },
    "show_in_distance": {
      "type": "boolean",
      "default": true,
      "description": "Show this place on the Distance Overview tab"
    }
  },
  "required": [
    "slug",
    "label",
    "kind"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}