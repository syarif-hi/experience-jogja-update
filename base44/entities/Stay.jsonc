{
  "name": "Stay",
  "type": "object",
  "title": "Stay",
  "description": "Hotels and accommodations \u2014 a distinct entity from Destination because pricing/amenity fields differ meaningfully",
  "properties": {
    "slug": {
      "type": "string"
    },
    "name_id": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "regency": {
      "type": "string",
      "enum": [
        "yogyakarta-city",
        "sleman",
        "bantul",
        "kulon-progo",
        "gunungkidul",
        "villages-hidden-gems"
      ]
    },
    "star_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "price_idr_per_night": {
      "type": "number"
    },
    "hero_image_url": {
      "type": "string",
      "format": "uri"
    },
    "gallery_image_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "description_id": {
      "type": "string",
      "format": "richtext"
    },
    "description_en": {
      "type": "string",
      "format": "richtext"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. Pool, Wifi, Breakfast Included, Parking"
    },
    "check_in_time": {
      "type": "string"
    },
    "check_out_time": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "contact_or_inquiry_url": {
      "type": "string",
      "description": "External booking/contact link \u2014 no in-app checkout"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "slug",
    "name_id",
    "name_en",
    "regency",
    "price_idr_per_night"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}